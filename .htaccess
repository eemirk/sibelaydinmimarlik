# ==========================================================================
#  Sibel Aydın Mimarlık — Apache / LiteSpeed (Veridyen cPanel)
# ==========================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType image/avif .avif
AddType font/woff2 .woff2
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- 1) Eski site adresleri (EN ÜSTTE) ------------------------------------
  # Hedefler doğrudan kanonik adrese gider; http/www yönlendirmesiyle zincir oluşmaz.
  RewriteRule ^Icerik/Iletisim/?$   https://www.sibelaydinmimarlik.com.tr/iletisim/ [R=301,L,NC]
  RewriteRule ^Icerik/Kurumsal/?$   https://www.sibelaydinmimarlik.com.tr/kurumsal/ [R=301,L,NC]
  RewriteRule ^Icerik/Referanslar/?$ https://www.sibelaydinmimarlik.com.tr/projeler/ [R=301,L,NC]
  RewriteRule ^Icerik/.*$           https://www.sibelaydinmimarlik.com.tr/ [R=301,L,NC]
  # Ayrı randevu sayfası yok (randevu WhatsApp üzerinden) → iletişim
  RewriteRule ^randevu/?$           https://www.sibelaydinmimarlik.com.tr/iletisim/ [R=301,L,NC]

  # --- 2) HTTPS + www (yalnızca gerçek alan adında; geçici cPanel adresi etkilenmez)
  RewriteCond %{HTTP_HOST} sibelaydinmimarlik\.com\.tr$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.sibelaydinmimarlik.com.tr%{REQUEST_URI} [R=301,L,NE]

  # --- 3) /index.html → klasör adresi (tek kanonik URL)
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # --- 4) Gizli/geliştirme dosyalarını dışarı kapat
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(tools|_dev|node_modules)(/|$) - [R=404,L,NC]
</IfModule>

# Nokta dosyaları (.env, .git vb.) — mod_rewrite yoksa da kapalı
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(env|log|ini|mjs|md|ps1|bak|sql)$">
  Require all denied
</FilesMatch>

# --- Güvenlik başlıkları ----------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # HTTPS sertifikası kalıcı olarak çalıştığı doğrulandıktan sonra açın:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header unset X-Powered-By
</IfModule>

# --- Sıkıştırma (Brotli varsa önce o, yoksa Gzip; LiteSpeed kendi de sıkıştırır)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript text/javascript application/json application/ld+json application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json application/ld+json application/xml image/svg+xml application/manifest+json
</IfModule>

# --- Tarayıcı önbelleği --------------------------------------------------------
# CSS/JS 1 yıl önbelleklenir: değiştiğinde HTML'deki ?v=YYYYMMDD değerini MUTLAKA artırın.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|svg|ico|woff2|mp4|css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
